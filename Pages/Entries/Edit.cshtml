@page "{id:int}"
@model DiaryApp.Pages.Entries.EditModel
@{ ViewData["Title"] = "Edit entry"; }

<h1>Edit entry</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Entry.Id" />
    <div class="mb-3">
        <label asp-for="Entry.Title" class="form-label"></label>
        <input asp-for="Entry.Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Entry.Content" class="form-label"></label>
        <textarea asp-for="Entry.Content" class="form-control" rows="6"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>